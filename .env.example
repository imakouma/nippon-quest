# Server only. Never prefix secrets with VITE_.
NQ_ORIGIN=http://127.0.0.1:4177
PORT=8789
HOST=127.0.0.1
DATABASE_URL=postgresql://user:password@localhost:5432/nihonquest
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vite reads this from the process environment, not this file.
NQ_API_ORIGIN=http://127.0.0.1:8789
# Only for compose.account-local.yaml. Generate independently of app credentials.
NQ_LOCAL_DB_ADMIN_PASSWORD=
# Set only to the exact IP of your TLS proxy, which must overwrite X-Forwarded-For.
NQ_TRUSTED_PROXY_IP=

  "events": [
    {
      "id": "ev-shimane-matsue-jo",
      "motifId": "matsue-jo",
      "trigger": {
        "map": "shimane-field",
        "objectName": "event_shimane_matsue-jo"
      },
      "once": true,
      "cutinImageKey": "motif.shimane.matsue-jo",
      "dialogue": [
        {
          "speaker": "シオリ",
          "text": "湖[みずうみ]を 見[み]ていた 人[ひと]の 証言[しょうげん]と、岸[きし]に のこる 綱[つな]の 跡[あと]が 合[あ]わない。見[み]えた 範囲[はんい]を 地図[ちず]にしよう。"
        },
        {
          "speaker": "お城[しろ]の ガイドさん",
          "text": "ここは 松江城[まつえじょう]。400年[ねん]いじょう 前[まえ]に 建[た]てられた 天守[てんしゅ]が、いまも のこって いるんだ。"
        },
        {
          "speaker": "お城[しろ]の ガイドさん",
          "text": "むかしの くらしや お城[しろ]の ことを しらべよう！"
        }
      ],
      "question": {
        "subject": "shakai",
        "gradeRange": [
          3,
          6
        ],
        "tags": [
          "prefecture:shimane"
        ]
      },
      "rewardByScore": [
        {
          "min": 1,
          "reward": {
            "xp": 40,
            "gold": 100
          }
        },
        {
          "min": 0.5,
          "reward": {
            "xp": 20,
            "gold": 50
          }
        },
        {
          "min": 0,
          "reward": {
            "xp": 10,
            "gold": 10
          }
        }
      ],
      "afterDialogue": [
        {
          "speaker": "ミチル",
          "text": "お城[しろ]の 影[かげ]と 島[しま]で 船[ふね]が 見[み]えなかったんだ。見[み]えないことと、なかったことは ちがうね。"
        },
        {
          "speaker": "お城[しろ]の ガイドさん",
          "text": "よく しらべたね！ 松江城[まつえじょう]の 天守[てんしゅ]は、国宝[こくほう]に なって いるよ。"
        }
      ]
    }
  ],

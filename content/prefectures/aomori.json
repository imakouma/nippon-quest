  "motifs": [
    {
      "id": "ringo",
      "name": "りんご",
      "kind": "food",
      "imageKey": "motif.aomori.ringo",
      "blurb": "青森県[あおもりけん]は りんごの 生産量[せいさんりょう]が 日本[にほん]で いちばん 多[おお]い。"
    },
    {
      "id": "sannai-maruyama",
      "name": "三内丸山遺跡[さんないまるやまいせき]",
      "kind": "history",
      "imageKey": "motif.aomori.sannai-maruyama",
      "blurb": "5000年[ねん]ほど 前[まえ]の 縄文時代[じょうもんじだい]の 大[おお]きな 村[むら]のあと。大[おお]きな 柱[はしら]の 建物[たてもの]が 有名[ゆうめい]。"
    },
    {
      "id": "tsugaru-kaikyo",
      "name": "津軽海峡[つがるかいきょう]",
      "kind": "nature",
      "imageKey": "motif.aomori.tsugaru-kaikyo",
      "blurb": "本州[ほんしゅう]と 北海道[ほっかいどう]の 間[あいだ]の 海[うみ]。海[うみ]の 下[した]を 青函[せいかん]トンネルが 通[とお]っている。"
    },
    {
      "id": "towada-ko",
      "name": "十和田湖[とわだこ]",
      "kind": "nature",
      "imageKey": "motif.aomori.towada-ko",
      "blurb": "火山[かざん]の あとに 水[みず]が たまって できた 湖[みずうみ]。青森[あおもり]と 秋田[あきた]に またがる。"
    },
    {
      "id": "osorezan",
      "name": "恐山[おそれざん]",
      "kind": "landmark",
      "imageKey": "motif.aomori.osorezan",
      "blurb": "日本[にほん]で 有名[ゆうめい]な 霊場[れいじょう]の ひとつ。カラカラ 回[まわ]る 風車[かざぐるま]が たくさん。"
    },
    {
      "id": "nebuta",
      "name": "ねぶた祭[まつり]",
      "kind": "festival",
      "imageKey": "motif.aomori.nebuta",
      "blurb": "夏[なつ]の 夜[よる]、光[ひか]る 大[おお]きな 人形[にんぎょう]の 山車[だし]が 町[まち]を ねり歩[ある]く。"
    },
    {
      "id": "oma-maguro",
      "name": "大間[おおま]のマグロ",
      "kind": "food",
      "imageKey": "motif.aomori.oma-maguro",
      "blurb": "津軽海峡[つがるかいきょう]で とれる 大[おお]きな クロマグロ。"
    },
    {
      "id": "shirakami",
      "name": "白神山地[しらかみさんち]",
      "kind": "nature",
      "imageKey": "motif.aomori.shirakami",
      "blurb": "ブナの 森[もり]が 広[ひろ]がる 世界自然遺産[せかいしぜんいさん]。秋田[あきた]との さかいに ある。"
    },
    {
      "id": "hirosaki-jo",

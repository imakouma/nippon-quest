      "once": true,
      "cutinImageKey": "motif.miyagi.matsushima",
      "dialogue": [
        {
          "speaker": "松島[まつしま]の 船頭[せんどう]さん",
          "text": "島[しま]の 名前[なまえ]と 航路[こうろ]を わすれて、ふねを 出[だ]せないんだ。対岸[たいがん]へ とどけたい 荷物[にもつ]が あるのに……。"
        },
        {
          "speaker": "ミチル",
          "text": "見[み]えている 島[しま]を よく たしかめよう。知[し]っていることを 使[つか]えば、安全[あんぜん]な 道[みち]を えらべるよ。"
        }
      ],
      "question": {
        "subject": "shakai",
        "gradeRange": [
          3,
          6
        ],
        "tags": [
          "prefecture:miyagi"
        ]
      },
      "rewardByScore": [
        {
          "min": 1,
          "reward": {
            "xp": 40,
            "gold": 100
          }
        },
        {
          "min": 0.5,
          "reward": {
            "xp": 20,
            "gold": 50
          }
        },
        {
          "min": 0,
          "reward": {
            "xp": 10,
            "gold": 10
          }
        }
      ],
      "afterDialogue": [
        {
          "speaker": "松島[まつしま]の 船頭[せんどう]さん",
          "text": "航路[こうろ]が わかったぞ！ これで 荷物[にもつ]も 人[ひと]も むこう岸[ぎし]へ とどけられる。ありがとう！"
        },
        {
          "speaker": "ミチル",
          "text": "知識[ちしき]が くらしの 道[みち]に なったね。……結晶[けっしょう]だけを 急[いそ]いでいたら、この ふねは 動[うご]かなかった。"
        }
      ]
    }
  ],

          "min": 1,
          "reward": {
            "xp": 40,
            "gold": 100
          }
        },
        {
          "min": 0.5,
          "reward": {
            "xp": 20,
            "gold": 50
          }
        },
        {
          "min": 0,
          "reward": {
            "xp": 10,
            "gold": 10
          }
        }
      ],
      "afterDialogue": [
        {
          "speaker": "田沢湖[たざわこ]の ガイドさん",
          "text": "記録[きろく]が 読[よ]める！ みんなへ 伝[つた]えて、食[た]べものと まきを 分[わ]けておくよ。これで 冬[ふゆ]を むかえられる。"
        },
        {
          "speaker": "ミチル",
          "text": "知[し]ったことを 分[わ]けあえば、だれかを 守[まも]る じゅんびが できるんだね。"
        }
      ]
    }
  ],

      "cutinImageKey": "motif.akita.tazawako",
      "dialogue": [
        {
          "speaker": "田沢湖[たざわこ]の ガイドさん",
          "text": "湖[みずうみ]の 水[みず]や 天気[てんき]の 記録[きろく]が 読[よ]めなくなったんだ。このままでは 冬[ふゆ]じたくを いつ 始[はじ]めればいいか わからないよ。"
        },
        {
          "speaker": "ミチル",
          "text": "水[みず]の ようすを 観察[かんさつ]して、わかったことを ガイドさんへ 伝[つた]えよう。"
        }
      ],
      "question": {
        "subject": "seikatsu",
        "gradeRange": [
          1,
          2
        ],
        "tags": [
          "prefecture:akita"
        ]
      },
      "rewardByScore": [

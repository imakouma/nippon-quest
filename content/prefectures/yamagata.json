      "once": true,
      "cutinImageKey": "motif.yamagata.zao",
      "dialogue": [
        {
          "speaker": "樹氷[じゅひょう]の ガイドさん",
          "text": "道[みち]しるべの ことばが きえて、山[やま]の ようすを 次[つぎ]の 人[ひと]へ 伝[つた]えられないんだ。氷[こおり]と 雪[ゆき]を いっしょに しらべてくれる？"
        },
        {
          "speaker": "ミチル",
          "text": "見[み]つけたことを ことばに すれば、まだ ここへ 来[き]ていない 人[ひと]にも 景色[けしき]を わたせるよ。"
        }
      ],
      "question": {
        "subject": "kokugo",
        "gradeRange": [
          1,
          2
        ],
        "tags": [
          "prefecture:yamagata"
        ]
      },
      "rewardByScore": [
        {
          "min": 1,
          "reward": {
            "xp": 40,
            "gold": 100
          }
        },
        {
          "min": 0.5,
          "reward": {
            "xp": 20,
            "gold": 50
          }
        },
        {
          "min": 0,
          "reward": {
            "xp": 10,
            "gold": 10
          }
        }
      ],
      "afterDialogue": [
        {
          "speaker": "樹氷[じゅひょう]の ガイドさん",
          "text": "きみの ことばを 道[みち]しるべに 書[か]いたよ。これなら 次[つぎ]の 人[ひと]も、気[き]をつけながら 景色[けしき]を たのしめる。"
        },
        {
          "speaker": "ミチル",
          "text": "ことばは、おぼえるためだけじゃない。見[み]たものを だれかへ 手[て]わたすためにも あるんだね。"
        }
      ]
    }
  ],

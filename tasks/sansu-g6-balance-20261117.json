  "groups": [
    {
      "id": "symmetry",
      "judgment": "定義・対応・作図・多角形の性質を18問で扱う。図から答えを読む問題が中心。",
      "gaps": "線対称と点対称を同一視しない理由判断を補う。",
      "addedIds": ["sansu.g6.balance.symmetry-counterexample"],
      "before": {
        "basic": 6,
        "standard": 12
      },
      "after": {
        "basic": 6,
        "standard": 12,
        "advanced": 1
      }
    },
    {
      "id": "letters",
      "judgment": "14問で式の表現、代入、値から文字を求める逆思考まで扱う。",
      "gaps": "追加不要。図形・買物・割合の場面もある。",
      "addedIds": [],
      "before": {
        "basic": 4,
        "standard": 8,
        "advanced": 2
      },
      "after": {
        "basic": 4,
        "standard": 8,
        "advanced": 2
      }
    },
    {
      "id": "fraction-integers",
      "judgment": "8問がすべて式だけの計算で、計算技能に偏る。",
      "gaps": "整数倍と等分の意味を異なる生活場面で補う。",
      "addedIds": ["sansu.g6.balance.fraction-packets", "sansu.g6.balance.fraction-share"],
      "before": {
        "basic": 8
      },
      "after": {
        "basic": 8,
        "standard": 2
      }
    },
    {
      "id": "fraction-multiplication",
      "judgment": "16問。分数倍の意味、約分、帯分数、積の大小、分配法則を含む。",
      "gaps": "追加不要。基礎計算の反復には約分位置等の違いがある。",
      "addedIds": [],
      "before": {
        "basic": 9,
        "standard": 7
      },
      "after": {
        "basic": 9,
        "standard": 7
      }
    },
    {
      "id": "fraction-division",
      "judgment": "12問。包含除、計算、商の大小、単位量への逆算を含む。",
      "gaps": "追加不要。除数が分数の意味と計算法がそろう。",
      "addedIds": [],
      "before": {
        "standard": 7,
        "basic": 4,
        "advanced": 1
      },
      "after": {
        "standard": 7,
        "basic": 4,
        "advanced": 1
      }
    },
    {
      "id": "fraction-applications",
      "judgment": "11問。時間換算、面積・体積、基準量の逆算を含む。",
      "gaps": "追加不要。単位換算だけに偏っていない。",
      "addedIds": [],
      "before": {
        "basic": 6,
        "standard": 4,
        "advanced": 1
      },
      "after": {
        "basic": 6,
        "standard": 4,
        "advanced": 1
      }
    },
    {
      "id": "ratios",
      "judgment": "24問中20問は比の表現・値・簡単化・等しい比の処理。場面問題は既知の一方や全体から求める型。",
      "gaps": "比の差から一つ分を求める学年内の逆思考を1問補う。",

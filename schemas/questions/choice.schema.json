{
  "$ref": "#/definitions/question.choice",
  "definitions": {
    "question.choice": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "description": "一意なID。例 \"sansu.g1.tashizan.0001\""
          },
          "type": {
            "type": "string",
            "const": "choice"
          },
          "subject": {
            "type": "string",
            "enum": [
              "kokugo",
              "sansu",
              "rika",
              "shakai",
              "seikatsu",
              "eigo"
            ]
          },
          "grade": {
            "type": "number",
            "enum": [
              1,
              2,
              3,
              4,
              5,
              6
            ]
          },
          "unit": {
            "type": "string",
            "pattern": "^(kokugo|sansu|rika|shakai|seikatsu|eigo)\\.g[1-6]\\.[a-z0-9-]+$",
            "description": "単元コード"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeLimitSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "payload": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "問題文（RubyText）"
              },
              "promptImage": {
                "type": "string"
              },
              "promptAudio": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "description": "RubyText"
                    },
                    "image": {
                      "type": "string",
                      "description": "assets/ からの相対パス。例 questions/eigo/apple.png"
                    },
                    "audio": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 6
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "description": "正解の choice.id"
              },
              "shuffle": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "prompt",
              "choices",
              "answer"
            ],
            "additionalProperties": false
          },
          "explanation": {
            "type": "string",
            "description": "解説（RubyText）"
          }
        },
        "required": [
          "id",
          "type",
          "subject",
          "grade",
          "unit",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

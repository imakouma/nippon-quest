{
  "$ref": "#/definitions/question.random-calculation",
  "definitions": {
    "question.random-calculation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "description": "一意なID。例 \"sansu.g1.tashizan.0001\""
          },
          "type": {
            "type": "string",
            "const": "random-calculation"
          },
          "subject": {
            "type": "string",
            "enum": [
              "kokugo",
              "sansu",
              "rika",
              "shakai",
              "seikatsu",
              "eigo"
            ]
          },
          "grade": {
            "type": "number",
            "enum": [
              1,
              2,
              3,
              4,
              5,
              6
            ]
          },
          "unit": {
            "type": "string",
            "pattern": "^(kokugo|sansu|rika|shakai|seikatsu|eigo)\\.g[1-6]\\.[a-z0-9-]+$",
            "description": "単元コード"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeLimitSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "payload": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "const": "add"
              },
              "leftMin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "leftMax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "rightMin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "rightMax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "carry": {
                "type": "boolean"
              },
              "response": {
                "type": "string",
                "enum": [
                  "choice",
                  "text-input"
                ]
              }
            },
            "required": [
              "prompt",
              "operation",
              "leftMin",
              "leftMax",
              "rightMin",
              "rightMax",
              "carry",
              "response"
            ],
            "additionalProperties": false
          },
          "explanation": {
            "type": "string",
            "description": "解説（RubyText）"
          }
        },
        "required": [
          "id",
          "type",
          "subject",
          "grade",
          "unit",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

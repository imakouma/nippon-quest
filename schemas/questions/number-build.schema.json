{
  "$ref": "#/definitions/question.number-build",
  "definitions": {
    "question.number-build": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "description": "一意なID。例 \"sansu.g1.tashizan.0001\""
          },
          "type": {
            "type": "string",
            "const": "number-build"
          },
          "subject": {
            "type": "string",
            "enum": [
              "kokugo",
              "sansu",
              "rika",
              "shakai",
              "seikatsu",
              "eigo"
            ]
          },
          "grade": {
            "type": "number",
            "enum": [
              1,
              2,
              3,
              4,
              5,
              6
            ]
          },
          "unit": {
            "type": "string",
            "pattern": "^(kokugo|sansu|rika|shakai|seikatsu|eigo)\\.g[1-6]\\.[a-z0-9-]+$",
            "description": "単元コード"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeLimitSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "payload": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "問題文（RubyText）"
                  },
                  "answer": {
                    "type": "number"
                  },
                  "mode": {
                    "type": "string",
                    "const": "blocks"
                  },
                  "blocks": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "minItems": 1,
                    "maxItems": 4
                  },
                  "max": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "prompt",
                  "answer",
                  "mode",
                  "blocks",
                  "max"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "問題文（RubyText）"
                  },
                  "answer": {
                    "type": "number"
                  },
                  "mode": {
                    "type": "string",
                    "const": "keypad"
                  },
                  "maxDigits": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 6
                  }
                },
                "required": [
                  "prompt",
                  "answer",
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "description": "問題文（RubyText）"
                  },
                  "answer": {
                    "type": "number"
                  },
                  "mode": {
                    "type": "string",
                    "const": "numberline"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "step": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tolerance": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "prompt",
                  "answer",
                  "mode",
                  "min",
                  "max",
                  "step"
                ],
                "additionalProperties": false
              }
            ]
          },
          "explanation": {
            "type": "string",
            "description": "解説（RubyText）"
          }
        },
        "required": [
          "id",
          "type",
          "subject",
          "grade",
          "unit",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

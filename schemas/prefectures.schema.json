{
  "$ref": "#/definitions/prefectures",
  "definitions": {
    "prefectures": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "description": "一意なID（小文字英数字・ドット・ハイフン）"
        },
        "name": {
          "type": "string",
          "description": "RubyText: \"漢字[かんじ]\" 形式"
        },
        "island": {
          "$ref": "#/definitions/prefectures/properties/id"
        },
        "capital": {
          "$ref": "#/definitions/prefectures/properties/name",
          "description": "RubyText: \"漢字[かんじ]\" 形式"
        },
        "status": {
          "type": "string",
          "enum": [
            "playable",
            "stub"
          ],
          "default": "stub"
        },
        "mapKeys": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "town": {
              "type": "string"
            },
            "dungeon": {
              "type": "string"
            }
          },
          "required": [
            "field",
            "town",
            "dungeon"
          ],
          "additionalProperties": false
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/prefectures/properties/id"
              },
              "name": {
                "$ref": "#/definitions/prefectures/properties/name"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "landmark",
                  "food",
                  "craft",
                  "nature",
                  "festival",
                  "history"
                ]
              },
              "blurb": {
                "$ref": "#/definitions/prefectures/properties/name"
              },
              "imageKey": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "blurb",
              "imageKey"
            ],
            "additionalProperties": false
          }
        },
        "encounters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zone": {
                "type": "string",
                "description": "field / dungeon / マップ固有ゾーン名"
              },
              "region": {
                "$ref": "#/definitions/prefectures/properties/id",
                "description": "名所エリア（regions の id）。あれば その エリアの 中だけで つかう（エリアの 表が 無い 地面は region なしの 表）"
              },
              "table": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "monsterId": {
                      "$ref": "#/definitions/prefectures/properties/id"
                    },
                    "weight": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "monsterId",
                    "weight"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "stepsPerCheck": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "default": 12
              },
              "rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.25
              }
            },
            "required": [
              "zone",
              "table"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/prefectures/properties/id"
              },
              "name": {
                "type": "string",
                "description": "エリアの 名前（例：弘前城[ひろさきじょう]エリア）"
              },
              "motifs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/prefectures/properties/id"
                },
                "description": "この エリアの 名所（motifs の id）"
              },
              "boss": {
                "type": "object",
                "properties": {
                  "monsterId": {
                    "$ref": "#/definitions/prefectures/properties/id"
                  },
                  "level": {
                    "$ref": "#/definitions/prefectures/properties/encounters/items/properties/stepsPerCheck"
                  },
                  "line": {
                    "$ref": "#/definitions/prefectures/properties/name",
                    "description": "はなしかけた ときの ぬしの ひとこと"
                  }
                },
                "required": [
                  "monsterId",
                  "level"
                ],
                "additionalProperties": false,
                "description": "エリアの ぬし（さいしょの 名所の そばに 立つ。たおすと openedBy が この エリアの 関所が ひらく）"
              },
              "start": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "id",
              "name",
              "motifs"
            ],
            "additionalProperties": false
          },
          "default": [],
          "description": "名所エリア（無い 県は フィールドが 1 つの エリア）"
        },
        "regionGates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "between": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "$ref": "#/definitions/prefectures/properties/id"
                  },
                  {
                    "$ref": "#/definitions/prefectures/properties/id"
                  }
                ]
              },
              "openedBy": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*$",
                "description": "この エリアの ぬしを たおすと ひらく"
              }
            },
            "required": [
              "between",
              "openedBy"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "boss": {
          "$ref": "#/definitions/prefectures/properties/id",
          "description": "一意なID（小文字英数字・ドット・ハイフン）"
        },
        "midBoss": {
          "$ref": "#/definitions/prefectures/properties/id",
          "description": "フィールドに立つ中ボス（monsters の id）。倒すと次の県へのワープホールが開く"
        },
        "events": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/prefectures/properties/id"
                  },
                  "motifId": {
                    "$ref": "#/definitions/prefectures/properties/id"
                  },
                  "trigger": {
                    "type": "object",
                    "properties": {
                      "map": {
                        "type": "string"
                      },
                      "objectName": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "map",
                      "objectName"
                    ],
                    "additionalProperties": false
                  },
                  "once": {
                    "type": "boolean",
                    "default": true
                  },
                  "cutinImageKey": {
                    "type": "string"
                  },
                  "dialogue": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "speaker": {
                          "$ref": "#/definitions/prefectures/properties/name",
                          "description": "RubyText: \"漢字[かんじ]\" 形式"
                        },
                        "face": {
                          "type": "string"
                        },
                        "text": {
                          "$ref": "#/definitions/prefectures/properties/name"
                        }
                      },
                      "required": [
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "question": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string",
                        "enum": [
                          "kokugo",
                          "sansu",
                          "rika",
                          "shakai",
                          "seikatsu",
                          "eigo"
                        ]
                      },
                      "gradeRange": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": [
                          {
                            "type": "number",
                            "enum": [
                              1,
                              2,
                              3,
                              4,
                              5,
                              6
                            ]
                          },
                          {
                            "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/question/properties/gradeRange/items/0"
                          }
                        ]
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "type": {
                        "type": "string",
                        "description": "省略時はエンジンが選ぶ"
                      }
                    },
                    "required": [
                      "subject",
                      "gradeRange"
                    ],
                    "additionalProperties": false
                  },
                  "rewardByScore": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "reward": {
                          "type": "object",
                          "properties": {
                            "gold": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "xp": {
                              "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/rewardByScore/items/properties/reward/properties/gold"
                            },
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "itemId": {
                                    "$ref": "#/definitions/prefectures/properties/id"
                                  },
                                  "n": {
                                    "$ref": "#/definitions/prefectures/properties/encounters/items/properties/stepsPerCheck",
                                    "default": 1
                                  }
                                },
                                "required": [
                                  "itemId"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "skills": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/id"
                              }
                            },
                            "recipes": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/id"
                              }
                            },
                            "unlockMonsters": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/id"
                              }
                            },
                            "title": {
                              "$ref": "#/definitions/prefectures/properties/name",
                              "description": "RubyText: \"漢字[かんじ]\" 形式"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "min",
                        "reward"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "afterDialogue": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/dialogue/items"
                    }
                  }
                },
                "required": [
                  "id",
                  "motifId",
                  "trigger",
                  "dialogue",
                  "question",
                  "rewardByScore"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/prefectures/properties/id"
                  },
                  "motifId": {
                    "$ref": "#/definitions/prefectures/properties/id"
                  },
                  "trigger": {
                    "type": "object",
                    "properties": {
                      "map": {
                        "type": "string"
                      },
                      "objectName": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "map",
                      "objectName"
                    ],
                    "additionalProperties": false
                  },
                  "once": {
                    "type": "boolean",
                    "default": true
                  },
                  "cutinImageKey": {
                    "type": "string"
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "dialogue"
                            },
                            "lines": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/dialogue/items"
                              },
                              "minItems": 1
                            }
                          },
                          "required": [
                            "type",
                            "lines"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "choice"
                            },
                            "key": {
                              "$ref": "#/definitions/prefectures/properties/id"
                            },
                            "lines": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/dialogue/items"
                              },
                              "minItems": 1
                            },
                            "choices": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/name"
                              },
                              "minItems": 1
                            }
                          },
                          "required": [
                            "type",
                            "key",
                            "lines",
                            "choices"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "question"
                            },
                            "key": {
                              "$ref": "#/definitions/prefectures/properties/id"
                            },
                            "request": {
                              "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/question"
                            }
                          },
                          "required": [
                            "type",
                            "key",
                            "request"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "reward"
                            },
                            "scoreKey": {
                              "$ref": "#/definitions/prefectures/properties/id"
                            },
                            "table": {
                              "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/rewardByScore"
                            }
                          },
                          "required": [
                            "type",
                            "scoreKey",
                            "table"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "set-flag"
                            },
                            "flag": {
                              "$ref": "#/definitions/prefectures/properties/id"
                            }
                          },
                          "required": [
                            "type",
                            "flag"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "battle"
                            },
                            "key": {
                              "$ref": "#/definitions/prefectures/properties/id"
                            },
                            "enemyId": {
                              "$ref": "#/definitions/prefectures/properties/id"
                            },
                            "level": {
                              "$ref": "#/definitions/prefectures/properties/encounters/items/properties/stepsPerCheck"
                            },
                            "isBoss": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "type",
                            "key",
                            "enemyId"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "warp"
                            },
                            "map": {
                              "type": "string",
                              "minLength": 1
                            },
                            "spawn": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "type",
                            "map"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "branch"
                            },
                            "condition": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "choice"
                                    },
                                    "key": {
                                      "$ref": "#/definitions/prefectures/properties/id"
                                    },
                                    "equals": {
                                      "type": "integer",
                                      "minimum": 0
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "key",
                                    "equals"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "score"
                                    },
                                    "key": {
                                      "$ref": "#/definitions/prefectures/properties/id"
                                    },
                                    "min": {
                                      "type": "number",
                                      "minimum": 0,
                                      "maximum": 1
                                    },
                                    "max": {
                                      "type": "number",
                                      "minimum": 0,
                                      "maximum": 1
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "key",
                                    "min"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "battle"
                                    },
                                    "key": {
                                      "$ref": "#/definitions/prefectures/properties/id"
                                    },
                                    "outcome": {
                                      "type": "string",
                                      "enum": [
                                        "victory",
                                        "defeat"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "key",
                                    "outcome"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "const": "flag"
                                    },
                                    "flag": {
                                      "$ref": "#/definitions/prefectures/properties/id"
                                    },
                                    "isSet": {
                                      "type": "boolean",
                                      "default": true
                                    }
                                  },
                                  "required": [
                                    "type",
                                    "flag"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            },
                            "then": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/events/items/anyOf/1/properties/steps/items"
                              }
                            },
                            "else": {
                              "type": "array",
                              "items": {
                                "$ref": "#/definitions/prefectures/properties/events/items/anyOf/1/properties/steps/items"
                              }
                            }
                          },
                          "required": [
                            "type",
                            "condition",
                            "then"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "motifId",
                  "trigger",
                  "steps"
                ],
                "additionalProperties": false
              }
            ]
          },
          "default": []
        },
        "shop": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "$ref": "#/definitions/prefectures/properties/id"
              },
              "price": {
                "$ref": "#/definitions/prefectures/properties/encounters/items/properties/stepsPerCheck"
              }
            },
            "required": [
              "itemId",
              "price"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "missions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/prefectures/properties/id"
              },
              "title": {
                "$ref": "#/definitions/prefectures/properties/name"
              },
              "giverNpc": {
                "$ref": "#/definitions/prefectures/properties/id"
              },
              "condition": {
                "type": "string",
                "pattern": "^(?:(?:defeat|collect):[a-z0-9.-]+:[1-9]\\d*|perfect:(?:kokugo|sansu|rika|shakai|seikatsu|eigo):[1-9]\\d*|(?:event|recruit):[a-z0-9.-]+)$"
              },
              "reward": {
                "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/rewardByScore/items/properties/reward"
              },
              "hint": {
                "$ref": "#/definitions/prefectures/properties/name",
                "description": "RubyText: \"漢字[かんじ]\" 形式"
              }
            },
            "required": [
              "id",
              "title",
              "giverNpc",
              "condition",
              "reward"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "town": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/definitions/prefectures/properties/name"
            },
            "npcs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/prefectures/properties/id"
                  },
                  "name": {
                    "$ref": "#/definitions/prefectures/properties/name"
                  },
                  "spriteKey": {
                    "type": "string"
                  },
                  "face": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "shop",
                      "smith",
                      "inn",
                      "board",
                      "arena",
                      "dex",
                      "talk"
                    ]
                  },
                  "dialogue": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/prefectures/properties/events/items/anyOf/0/properties/dialogue/items"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "name",
                  "spriteKey",
                  "role",
                  "dialogue"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "name",
            "npcs"
          ],
          "additionalProperties": false
        },
        "secret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "裏ステージの 名前（例：仙台城[せんだいじょう] 本丸[ほんまる]）"
            },
            "boss": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]*$",
              "description": "ラスボス（monsters の id。その土地の 歴史上の 人物）"
            }
          },
          "required": [
            "name",
            "boss"
          ],
          "additionalProperties": false,
          "description": "裏ステージ：県ボスを 倒すと フィールドの 入口（scripts/data/secrets.ts の 場所）が ひらき、おくに ラスボスが いる"
        }
      },
      "required": [
        "id",
        "name",
        "island",
        "motifs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

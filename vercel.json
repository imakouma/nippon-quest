{
  "buildCommand": "pnpm build && pnpm exec vite build --config vite.account.config.ts",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:section(account|auth)/:rest*",
      "destination": "/api/dispatch?nqPath=:section/:rest*"
    }
  ]
}

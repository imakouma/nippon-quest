{
  "name": "nihonquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ニホンクエスト — 小学生向け・ゲーム主体の学習RPG（Phaser 3 + TypeScript）",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "source-map-js@<1.2.2": "1.2.2"
    }
  },
  "scripts": {
    "dev": "pnpm build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "dev:hmr": "pnpm gen:manifest && vite --host 127.0.0.1 --port 5173 --strictPort",
    "nrd": "npm run dev",
    "prebuild": "pnpm gen:manifest && pnpm gen:schemas && pnpm validate:content",
    "build": "pnpm typecheck:app && vite build",
    "preview": "vite preview",
    "lint:eslint": "eslint --cache --cache-location .cache/eslint .",
    "lint:format": "prettier --check --cache --cache-location .cache/prettier '*.{html,json,md,ts,js}' 'src/**/*.{ts,tsx,css}' 'scripts/**/*.{ts,mjs}' 'tests/**/*.{ts,tsx}' 'tasks/**/*.md' 'content/i18n/**/*.json'",
    "lint": "pnpm lint:eslint && pnpm lint:format",
    "format": "prettier --write --cache --cache-location .cache/prettier '*.{html,json,md,ts,js}' 'src/**/*.{ts,tsx,css}' 'scripts/**/*.{ts,mjs}' 'tests/**/*.{ts,tsx}' 'tasks/**/*.md' 'content/i18n/**/*.json'",
    "pretest": "pnpm gen:manifest",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:data": "vitest run --config vitest.data.config.ts",
    "test:related": "vitest related --run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert '全問題をバトル問題枠'",
    "test:e2e:smoke": "playwright test --config tests/e2e/playwright.prebuilt.config.ts ci-smoke.spec.ts",
    "test:e2e:full": "playwright test",
    "test:e2e:app": "pnpm test:e2e:field && pnpm test:e2e:bag && pnpm test:e2e:battle && pnpm test:e2e:onboarding && pnpm test:e2e:tools && pnpm test:e2e:flows",
    "test:e2e:field": "playwright test tests/e2e/aomori-boss-distance.spec.ts tests/e2e/area-map-navigation.spec.ts",
    "test:e2e:bag": "playwright test tests/e2e/bag-interactions.spec.ts",
    "test:e2e:battle": "playwright test tests/e2e/battle.spec.ts tests/e2e/battle-menu-readability.spec.ts tests/e2e/battle-question-audit.spec.ts tests/e2e/music.spec.ts tests/e2e/battle-sounds.spec.ts tests/e2e/enemy-knockout.spec.ts tests/e2e/skill-gauge-cost.spec.ts --grep-invert '全問題をバトル問題枠'",
    "test:e2e:onboarding": "playwright test tests/e2e/empty-save-slots.spec.ts tests/e2e/journey-setup.spec.ts tests/e2e/look-heading.spec.ts tests/e2e/mvp-regions.spec.ts tests/e2e/new-game-appearance.spec.ts tests/e2e/opening-cutscene.spec.ts",
    "test:e2e:tools": "playwright test tests/e2e/playground-list.spec.ts tests/e2e/questions.spec.ts tests/e2e/smoke.spec.ts",
    "test:e2e:flows": "pnpm test:e2e:flow-progress && pnpm test:e2e:flow-recovery && pnpm test:e2e:flow-companion && pnpm test:e2e:flow-accessibility",
    "test:e2e:flow-progress": "playwright test tests/e2e/progress.spec.ts",
    "test:e2e:flow-recovery": "playwright test tests/e2e/startup-retry.spec.ts",
    "test:e2e:flow-companion": "playwright test tests/e2e/story-companion.spec.ts",
    "test:e2e:flow-accessibility": "playwright test tests/e2e/ui-accessibility.spec.ts",
    "test:e2e:progression": "playwright test tests/e2e/island-progression.spec.ts tests/e2e/regional-progression.spec.ts",
    "test:e2e:audit": "playwright test tests/e2e/battle-question-audit.spec.ts --grep '全問題をバトル問題枠'",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "gen:monster-level-caps": "tsx scripts/set-monster-level-caps.ts",
    "gen:xp": "tsx scripts/gen-xp-table.ts",
    "gen:manifest": "tsx scripts/gen-manifest.ts && tsx scripts/gen-asset-catalog.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:curriculum-graph": "tsx scripts/validate-curriculum-graph.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:performance": "tsx scripts/check-performance-budget.ts",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:tests && pnpm typecheck:tools",
    "audit:curriculum": "tsx scripts/audit-curriculum.ts",
    "audit:curriculum-model": "tsx scripts/audit-curriculum-model.ts",
    "audit:roadmap-graph": "tsx scripts/audit-roadmap-graph.ts",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "audit:academic-review": "tsx scripts/audit-academic-review.ts",
    "audit:academic-review:strict": "tsx scripts/audit-academic-review.ts --strict",
    "academic-review:record": "tsx scripts/record-academic-review.ts",
    "inventory:cinematics": "tsx scripts/inventory-cinematic-assets.ts",
    "audit:worldmap": "tsx scripts/audit-worldmap.ts",
    "audit:battle-balance": "tsx scripts/audit-battle-balance.ts",
    "import:legacy-questions": "tsx scripts/import-legacy-questions.ts",
    "import:legacy-roadmap": "tsx scripts/import-legacy-roadmap.ts",
    "localize:legacy-images": "tsx scripts/localize-legacy-images.ts",
    "promote:legacy-questions": "tsx scripts/promote-legacy-questions.ts",
    "promote:legacy-bulk": "tsx scripts/promote-legacy-bulk.ts",
    "scaffold:area": "tsx scripts/scaffold-area.ts",
    "scaffold:all-areas": "tsx scripts/scaffold-area.ts --all",
    "scaffold:maps": "tsx scripts/scaffold-maps.ts",
    "gen:terrain": "tsx scripts/gen-terrain.ts",
    "check:fast": "pnpm lint && pnpm check:architecture && pnpm typecheck:app",
    "check:full": "pnpm lint && pnpm check:architecture && pnpm gen:manifest && pnpm gen:schemas && pnpm audit:curriculum --strict && pnpm audit:curriculum-model --strict && pnpm audit:roadmap-graph --strict && pnpm audit:worldmap && pnpm test:unit && pnpm validate:content && pnpm validate:curriculum-graph && pnpm typecheck && pnpm exec vite build && pnpm check:performance",
    "check": "pnpm check:full"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "phaser": "^3.87.0",
    "preact": "^10.24.0",
    "seedrandom": "^3.0.5",
    "zod": "4.6.6",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^22.7.5",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  }
}

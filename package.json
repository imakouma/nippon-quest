{
  "name": "nihonquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ニホンクエスト — 小学生向け・ゲーム主体の学習RPG（Phaser 3 + TypeScript）",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "source-map-js@<1.2.2": "1.2.2"
    }
  },
  "scripts": {
    "dev": "pnpm build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "dev:hmr": "pnpm gen:manifest && vite --host 127.0.0.1 --port 5173 --strictPort",
    "nrd": "npm run dev",
    "prebuild": "pnpm gen:manifest && pnpm gen:schemas && pnpm validate:content",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretest": "pnpm gen:manifest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:app && pnpm test:e2e:progression && pnpm test:e2e:audit",
    "test:e2e:app": "pnpm test:e2e:field && pnpm test:e2e:bag && pnpm test:e2e:battle && pnpm test:e2e:onboarding && pnpm test:e2e:tools && pnpm test:e2e:flows",
    "test:e2e:field": "playwright test tests/e2e/aomori-boss-distance.spec.ts tests/e2e/area-map-navigation.spec.ts",
    "test:e2e:bag": "playwright test tests/e2e/bag-interactions.spec.ts",
    "test:e2e:battle": "playwright test tests/e2e/battle.spec.ts tests/e2e/battle-question-audit.spec.ts --grep-invert '全問題をバトル問題枠'",
    "test:e2e:onboarding": "playwright test tests/e2e/empty-save-slots.spec.ts tests/e2e/journey-setup.spec.ts tests/e2e/look-heading.spec.ts tests/e2e/mvp-regions.spec.ts tests/e2e/new-game-appearance.spec.ts tests/e2e/opening-cutscene.spec.ts",
    "test:e2e:tools": "playwright test tests/e2e/playground-list.spec.ts tests/e2e/questions.spec.ts tests/e2e/smoke.spec.ts",
    "test:e2e:flows": "pnpm test:e2e:flow-progress && pnpm test:e2e:flow-recovery && pnpm test:e2e:flow-companion && pnpm test:e2e:flow-accessibility",
    "test:e2e:flow-progress": "playwright test tests/e2e/progress.spec.ts",
    "test:e2e:flow-recovery": "playwright test tests/e2e/startup-retry.spec.ts",
    "test:e2e:flow-companion": "playwright test tests/e2e/story-companion.spec.ts",
    "test:e2e:flow-accessibility": "playwright test tests/e2e/ui-accessibility.spec.ts",
    "test:e2e:progression": "playwright test tests/e2e/island-progression.spec.ts",
    "test:e2e:audit": "playwright test tests/e2e/battle-question-audit.spec.ts --grep '全問題をバトル問題枠'",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "gen:manifest": "tsx scripts/gen-manifest.ts && tsx scripts/gen-asset-catalog.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:curriculum-graph": "tsx scripts/validate-curriculum-graph.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "audit:curriculum": "tsx scripts/audit-curriculum.ts",
    "audit:curriculum-model": "tsx scripts/audit-curriculum-model.ts",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "audit:academic-review": "tsx scripts/audit-academic-review.ts",
    "audit:academic-review:strict": "tsx scripts/audit-academic-review.ts --strict",
    "audit:worldmap": "tsx scripts/audit-worldmap.ts",
    "audit:battle-balance": "tsx scripts/audit-battle-balance.ts",
    "import:legacy-questions": "tsx scripts/import-legacy-questions.ts",
    "import:legacy-roadmap": "tsx scripts/import-legacy-roadmap.ts",
    "localize:legacy-images": "tsx scripts/localize-legacy-images.ts",
    "promote:legacy-questions": "tsx scripts/promote-legacy-questions.ts",
    "promote:legacy-bulk": "tsx scripts/promote-legacy-bulk.ts",
    "scaffold:area": "tsx scripts/scaffold-area.ts",
    "scaffold:all-areas": "tsx scripts/scaffold-area.ts --all",
    "scaffold:maps": "tsx scripts/scaffold-maps.ts",
    "gen:terrain": "tsx scripts/gen-terrain.ts",
    "check": "pnpm lint && pnpm check:architecture && pnpm audit:curriculum --strict && pnpm audit:curriculum-model --strict && pnpm audit:worldmap && pnpm test && pnpm validate:content && pnpm validate:curriculum-graph && pnpm build"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "phaser": "^3.87.0",
    "preact": "^10.24.0",
    "seedrandom": "^3.0.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.9.1",
    "@types/node": "^22.7.5",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
